# Requires Plasma 6.7+ (KF6 6.26, Qt 6.10, KWin 6.7+). Builds against 6.7 and 6.8.

pkgname=plasmazones
# pkgver/pkgrel are placeholders; CI rewrites them against the release tag
# before publishing. See packaging/arch/update-aur.sh.
pkgver=0.0.0
pkgrel=1
pkgdesc='Window snapping, tiling and scrolling for KDE Plasma'
arch=('x86_64')
url='https://github.com/phosphor-works/PlasmaZones'
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later')

# KWin: minimum version, NOT an exact pin. The kwin-effect plugin's IID embeds
# KWin's exact upstream version string and KWin refuses to load an effect whose
# IID doesn't match its own version (even across patch bumps, e.g. 6.7.0 ->
# 6.7.1). An exact `kwin=<ver>` pin, however, makes pacman hold KWin back on
# -Syu whenever a newer KWin lands before this package is rebuilt, stranding the
# desktop in a half-upgraded Plasma ("No KScreen backend found", black screen).
# A mismatched effect is harmless — KWin reads the IID from plugin metadata and
# never loads a non-matching effect, so the .so stays inert; only the drag
# overlay is missing until a rebuild. Core tiling runs in the daemon +
# layer-shell QPA plugin and is independent of the effect.
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-shadertools'
    'qt6-svg'
    'kconfig'
    'kconfigwidgets'
    'kirigami'
    'kcmutils'
    'kglobalaccel'
    'kcolorscheme'
    'qt6-wayland'
    'kwin>=6.7.0'
)
makedepends=(
    'cmake'
    'extra-cmake-modules'
    'ninja'
    'qt6-tools'
    'kwin'
    'wayland'
    'vulkan-headers'
    'vulkan-icd-loader'
)
optdepends=(
    'plasma-activities: activity-based layouts'
    'hwdata: readable GPU names in the rendering device picker'
)
conflicts=('plasmazones-bin' 'plasmazones-git')
# The release tarball, then the archives the build compiles in: the phosphor-libs
# commit, the branding release and the surface packs commit pinned (version,
# URL and SHA-256) in
# cmake/PlasmaZonesDependencies.cmake, and the third-party sources that
# phosphor-libs commit pins in its own cmake/PhosphorDependencies.cmake.
# check-conventions.py's dep-pins rule fails when the URLs and hashes here
# stop matching the pin, so bump them together. They stay archives (noextract):
# build() hands $srcdir to CMake as PHOSPHOR_DEPS_ARCHIVES, which checks each
# hash and unpacks it itself, so the build never reaches the network.
source=(
    "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
    "phosphor-libs-d652b2e06424fba0e692a3f045c7c125fa04da8c.tar.gz::https://github.com/phosphor-works/phosphor-libs/archive/d652b2e06424fba0e692a3f045c7c125fa04da8c.tar.gz"
    "luau-0.745.tar.gz::https://github.com/luau-lang/luau/archive/refs/tags/0.745.tar.gz"
    "valijson-1.1.3.tar.gz::https://github.com/tristanpenman/valijson/archive/refs/tags/v1.1.3.tar.gz"
    "phosphor-branding-0.3.1.tar.gz::https://github.com/phosphor-works/branding/releases/download/v0.3.1/phosphor-branding-0.3.1.tar.gz"
    "phosphor-surface-packs-c897e15f899565740b3bd0ec05d16ac9cabe186c.tar.gz::https://github.com/phosphor-works/phosphor-surface-packs/archive/c897e15f899565740b3bd0ec05d16ac9cabe186c.tar.gz"
    "phosphor-components-c434e5cdf3781a844e408e922afa0a3d88b4b026.tar.gz::https://github.com/phosphor-works/phosphor-components/archive/c434e5cdf3781a844e408e922afa0a3d88b4b026.tar.gz"
)
noextract=('phosphor-libs-d652b2e06424fba0e692a3f045c7c125fa04da8c.tar.gz' 'luau-0.745.tar.gz' 'valijson-1.1.3.tar.gz' 'phosphor-branding-0.3.1.tar.gz' 'phosphor-surface-packs-c897e15f899565740b3bd0ec05d16ac9cabe186c.tar.gz' 'phosphor-components-c434e5cdf3781a844e408e922afa0a3d88b4b026.tar.gz')
# The first entry is 'SKIP' so local `makepkg -p PKGBUILD` doesn't fail its
# integrity check on the placeholder pkgver. release.yml templates the real
# sha256 into that entry, and only that one, when publishing to AUR (see the
# awk rewrite in the publish-aur job, and update-aur.sh). Keep one entry per
# line with the release tarball's first: that rewrite relies on both.
sha256sums=(
    'SKIP'
    '3378eac1d5760230c5d3fe79dc3d0911741bfbcdcac24c7d84bd1be16c77fef3' # phosphor-libs-d652b2e06424fba0e692a3f045c7c125fa04da8c.tar.gz
    '53c22773bace6cabbabaead576fbc08d11a0317fce11a3dbf9d027dda6849248' # luau-0.745.tar.gz
    '887b53b1a924f6fe0b35fa3bbc9bbbe5ae8c72097b7f0f7c17b45f4cfa646029' # valijson-1.1.3.tar.gz
    'd6ec9261d4391148f5c21dfb02be410214d42ea675f1558a826042d63f495094' # phosphor-branding-0.3.1.tar.gz
    '5cfdd51c5dd1f96f1d4da6637d25a5e3fdb11fb683b3b39a13095fc8a0db4090' # phosphor-surface-packs-c897e15f899565740b3bd0ec05d16ac9cabe186c.tar.gz
    'e467912dc4dae79aee8a270fa846fa2a9fdea44daf62fba15510fcf2ae236cd5' # phosphor-components-c434e5cdf3781a844e408e922afa0a3d88b4b026.tar.gz
)
install=plasmazones.install

build() {
    cmake -B build -S "PlasmaZones-$pkgver" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DPHOSPHOR_DEPS_ARCHIVES="$srcdir" \
        -Wno-dev
    cmake --build build --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    # Install pacman hook to auto-refresh sycoca cache
    install -Dm644 "PlasmaZones-$pkgver/packaging/arch/kbuildsycoca.hook" \
        "$pkgdir/usr/share/libalpm/hooks/plasmazones-kbuildsycoca.hook"
    install -Dm755 "PlasmaZones-$pkgver/packaging/arch/plasmazones-refresh-sycoca" \
        "$pkgdir/usr/share/libalpm/scripts/plasmazones-refresh-sycoca"

    # License files — GPL-3.0-or-later (main) + LGPL-2.1-or-later (the
    # bundled Phosphor component libraries). The `license=()` array
    # above declares both; both files must be shipped under
    # /usr/share/licenses.
    install -Dm644 "PlasmaZones-$pkgver/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "PlasmaZones-$pkgver/COPYING.LESSER" \
        "$pkgdir/usr/share/licenses/$pkgname/COPYING.LESSER"

    # `cmake --install` above also installs every Phosphor component
    # shared library plus its CMake config and headers into /usr/lib
    # and /usr/include. No separate -devel package is produced; they
    # ship bundled with the main package.
}
