@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt6 @PHOSPHORCONTROL_QT_MIN@ COMPONENTS Core DBus Gui Qml Quick)

# PhosphorControl links PhosphorRegistry PUBLIC (FacetHost.h exposes its
# types), so the exported targets reference it. The QML module targets, which
# link PhosphorAnimation, are not exported.
find_dependency(PhosphorRegistry)

include("${CMAKE_CURRENT_LIST_DIR}/PhosphorControlTargets.cmake")

check_required_components(PhosphorControl)
