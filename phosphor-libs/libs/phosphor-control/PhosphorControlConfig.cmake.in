@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Qt6 @PHOSPHORCONTROL_QT_MIN@ COMPONENTS Core DBus Gui Qml Quick)

# PhosphorControl links PhosphorRegistry PUBLIC (ModuleHost.h exposes its
# types) and PhosphorConfig PUBLIC (ModuleContext::configBackend hands out its
# IBackend), so the exported targets reference both. The QML module targets,
# which link PhosphorAnimation, are not exported.
find_dependency(PhosphorRegistry)
find_dependency(PhosphorConfig)

include("${CMAKE_CURRENT_LIST_DIR}/PhosphorControlTargets.cmake")
# phosphor_add_control_module_metadata(), for building control modules.
include("${CMAKE_CURRENT_LIST_DIR}/PhosphorControlModule.cmake")

check_required_components(PhosphorControl)
